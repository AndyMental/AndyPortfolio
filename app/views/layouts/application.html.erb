<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_title %></title>
    <meta name="description" content="Andy Mental's portfolio — a Rails-backed blog companion to the andy-portfolio.com showcase.">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%# SimpleCSS pinned to jsDelivr 2.3.7 (immutable). Regenerate hash on upgrade: curl -fsSL <URL> | openssl dgst -sha384 -binary | openssl base64 -A %>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/simpledotcss@2.3.7/simple.min.css"
          integrity="sha384-w3/JhK7GP1jIgYT9phdYXYeUKzhTc4AxDpfqFZO1tkmCHBZrEmZ2c68gaD1yKhZq"
          crossorigin="anonymous"
          referrerpolicy="no-referrer">
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
