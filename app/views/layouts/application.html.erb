<!DOCTYPE html>
<html lang="en">
  <head>
    <title>AndyPortfolio</title>
    <meta name="description" content="<%= yield(:meta_description).presence || default_meta_description %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= yield(:meta_description).presence || default_meta_description %>">
    <meta property="og:type" content="website">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
