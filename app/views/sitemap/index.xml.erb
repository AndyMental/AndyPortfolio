<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc><%= root_url %></loc>
  </url>
  <url>
    <loc><%= blogs_url %></loc>
  </url>
<% @blogs.each do |blog| %>
  <url>
    <loc><%= blog_url(blog) %></loc>
    <% if blog.updated_at %><lastmod><%= blog.updated_at.utc.iso8601 %></lastmod><% end %>
  </url>
<% end %>
</urlset>
