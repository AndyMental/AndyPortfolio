<% content_for :title, "Blog" %>

<% if notice.present? %>
  <p style="color: green" role="status" aria-live="polite"><%= notice %></p>
<% end %>

<%= render "shared/breadcrumbs" %>

<section class="page-header">
  <p class="eyebrow">Andy Mental</p>
  <h1>Blog</h1>
  <p>Notes and updates from the Rails-backed portfolio companion.</p>

  <% if blog_admin? %>
    <p><%= link_to "New blog", new_blog_path, class: "button" %></p>
  <% end %>
</section>

<section id="blogs" class="blog-list" aria-label="Blog posts">
  <% if @blogs.any? %>
    <% @blogs.each do |blog| %>
      <article id="<%= dom_id blog %>" class="blog-card">
        <header>
          <h2><%= link_to blog.title, blog %></h2>
          <p><time datetime="<%= blog.created_at.to_date %>"><%= blog.created_at.strftime("%B %d, %Y") %></time></p>
        </header>
        <div class="blog-body">
          <%= sanitize blog.body, tags: %w[p br strong em b i ul ol li a], attributes: %w[href title rel target] %>
        </div>
        <p><%= link_to "Read post", blog, aria: { label: "Read #{blog.title}" } %></p>
      </article>
    <% end %>
  <% else %>
    <article class="empty-state">
      <h2>No posts yet</h2>
      <p>Check back soon for public updates.</p>
    </article>
  <% end %>
</section>
