<% content_for :title, "Blog" %>
<% content_for :header_title, "Blogs" %>
<% content_for :description, "Read the latest updates and articles from Andy Mental." %>

<%= render "breadcrumbs", links: [["Blog", nil]] %>

<% if notice.present? %>
  <p style="color: green" role="status" aria-live="polite"><%= notice %></p>
<% end %>

<%= form_with url: blogs_path, method: :get, class: "search-form" do |form| %>
  <%= form.label :q, "Search blogs:" %>
  <%= form.text_field :q, value: params[:q], id: "q", placeholder: "Keyword..." %>
  <%= form.submit "Search" %>
  <% if params[:q].present? || params[:tag].present? %>
    <%= link_to "Clear", blogs_path %>
  <% end %>
<% end %>

<% if params[:tag].present? %>
  <p role="status" aria-live="polite">
    Filtering by tag: <strong><%= params[:tag] %></strong>
  </p>
<% end %>

<% if @blogs.empty? %>
  <section role="status" aria-live="polite">
    <h2>No posts yet</h2>
    <p>There aren't any blog posts to read right now. Check back soon.</p>
  </section>
<% else %>
  <div id="blogs">
    <% @blogs.each do |blog| %>
      <%= render blog %>
      <hr>
    <% end %>
  </div>
<% end %>

<% if blog_admin? %>
  <p>
    <%= link_to "New blog", new_blog_path %>
  </p>
<% end %>
<p>
  <%= link_to "RSS Feed", blogs_path(format: :rss) %>
</p>
