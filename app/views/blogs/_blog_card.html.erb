<div class="blog-card" id="<%= dom_id blog %>">
  <h2><%= blog.title %></h2>
  <div class="blog-excerpt">
    <%= sanitize blog.body, tags: %w[p br strong em b i ul ol li a], attributes: %w[href title rel target] %>
  </div>
  <div class="blog-actions">
    <%= link_to "Show this blog", blog %>
  </div>
</div>