<% blog_excerpt = strip_tags(@blog.body.to_s).squish %>
<% content_for :meta_description, blog_excerpt.presence ? blog_excerpt.truncate(160) : "Blog post on AndyPortfolio by Andy Mental." %>

<% if notice.present? %>
  <p style="color: green" role="status" aria-live="polite"><%= notice %></p>
<% end %>

<%= render @blog %>

<div>
  <% if blog_admin? %>
    <%= link_to "Edit this blog", edit_blog_path(@blog) %> |
  <% end %>
  <%= link_to "Back to blogs", blogs_path %>

  <% if blog_admin? %>
    <%= button_to "Destroy this blog", @blog, method: :delete %>
  <% end %>
</div>
