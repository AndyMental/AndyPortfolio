<% content_for :title, @blog.title %>

<% if notice.present? %>
  <p style="color: green" role="status" aria-live="polite"><%= notice %></p>
<% end %>

<%= render "shared/breadcrumbs" %>

<article id="<%= dom_id @blog %>" class="blog-post">
  <header>
    <h1><%= @blog.title %></h1>
    <p class="eyebrow"><time datetime="<%= @blog.created_at.to_date %>"><%= @blog.created_at.strftime("%B %d, %Y") %></time></p>
  </header>
  <div class="blog-body">
    <%= sanitize @blog.body, tags: %w[p br strong em b i ul ol li a], attributes: %w[href title rel target] %>
  </div>
</article>

<div class="admin-actions">
  <% if blog_admin? %>
    <%= link_to "Edit this blog", edit_blog_path(@blog) %> |
  <% end %>

  <% if blog_admin? %>
    <%= button_to "Destroy this blog", @blog, method: :delete %>
  <% end %>
</div>
