<% content_for :title, @blog.title %>
<% content_for :description, strip_tags(@blog.body).truncate(160) %>

<%= render "breadcrumbs", links: [["Blog", blogs_path], [@blog.title, nil]] %>

<% if notice.present? %>
  <p style="color: green" role="status" aria-live="polite"><%= notice %></p>
<% end %>

<%= render @blog %>

<hr>

<div>
  <% if blog_admin? %>
    <%= link_to "Edit this blog", edit_blog_path(@blog) %> |
  <% end %>
  <%= link_to "Back to blogs", blogs_path %>

  <% if blog_admin? %>
    <br><br>
    <%= button_to "Destroy this blog", @blog, method: :delete, data: { confirm: "Are you sure?" } %>
  <% end %>
</div>
